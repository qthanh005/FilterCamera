<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        android:background="#000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/rvFilters"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Face Overlay để vẽ sticker lên preview -->
    <com.example.cameraapp.FaceOverlayView
        android:id="@+id/faceOverlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="@+id/previewView"
        app:layout_constraintBottom_toBottomOf="@+id/previewView"
        app:layout_constraintStart_toStartOf="@+id/previewView"
        app:layout_constraintEnd_toEndOf="@+id/previewView" />

    <!-- Grid Overlay để hiển thị grid lines -->
    <com.example.cameraapp.GridOverlayView
        android:id="@+id/gridOverlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="@+id/previewView"
        app:layout_constraintBottom_toBottomOf="@+id/previewView"
        app:layout_constraintStart_toStartOf="@+id/previewView"
        app:layout_constraintEnd_toEndOf="@+id/previewView" />

    <!-- Countdown Timer Container -->
    <FrameLayout
        android:id="@+id/countdownContainer"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@+id/previewView"
        app:layout_constraintBottom_toBottomOf="@+id/previewView"
        app:layout_constraintStart_toStartOf="@+id/previewView"
        app:layout_constraintEnd_toEndOf="@+id/previewView">

        <!-- Background Circle với gradient -->
        <View
            android:id="@+id/countdownBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/countdown_bg"
            android:alpha="0.9" />

        <!-- Countdown Timer Text -->
        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="80sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:gravity="center"
            android:layout_gravity="center"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8" />

        <!-- Ripple Effect Circle -->
        <View
            android:id="@+id/rippleCircle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/countdown_bg"
            android:alpha="0"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Nút Google Drive (góc trên phải) -->
    <ImageButton
        android:id="@+id/btnGoogleDrive"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/btn_round_dark"
        android:padding="10dp"
        android:src="@drawable/ic_google_drive"
        android:contentDescription="Google Drive"
        android:elevation="8dp"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Indicator đã đăng nhập Google Drive -->
    <View
        android:id="@+id/driveStatusIndicator"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/dot_indicator_selected"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Nút Grid (góc trên trái) -->
    <ImageButton
        android:id="@+id/btnGrid"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/btn_round_dark"
        android:padding="10dp"
        android:src="@drawable/ic_grid"
        android:contentDescription="Grid"
        android:elevation="8dp"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ImageView hiển thị ảnh chụp -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        app:tint="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/rvFilters"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TextView trạng thái quyền -->
    <TextView
        android:id="@+id/tvPermissionStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đang kiểm tra quyền camera..."
        android:textSize="14sp"
        android:textColor="#CCCCCC"
        android:background="@android:color/transparent"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/rvFilters"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- RecyclerView filter -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFilters"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:visibility="gone"
        android:padding="8dp"
        android:clipToPadding="false"
        android:scrollbars="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/controlLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Thanh điều khiển dưới cùng -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/controlLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@drawable/bottom_control_bg"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Nút gallery (góc trái) -->
        <ImageButton
            android:id="@+id/btnGallery"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/btn_gallery_bg"
            android:clipToOutline="true"
            android:contentDescription="Thư viện"
            android:elevation="6dp"
            android:padding="12dp"
            android:scaleType="centerCrop"
            android:src="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnCapture"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:tint="@null" />

        <!-- Nút chụp chính -->
        <ImageButton
            android:id="@+id/btnCapture"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/btn_capture_circle"
            android:contentDescription="Capture"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ✅ Nút xoay camera -->

        <!-- Nút filter -->

        <ImageButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/btn_gallery_bg"
            android:clipToOutline="true"
            android:contentDescription="Đổi camera"
            android:elevation="6dp"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_switch_camera"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toEndOf="@+id/btnCapture"
            app:tint="@null" />

        <!-- Nút filter (góc dưới trái) -->
        <ImageButton
            android:id="@+id/btnFilter"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/btn_round_dark"
            android:padding="10dp"
            android:src="@drawable/ic_filter"
            android:contentDescription="Filter"
            android:visibility="gone"
            android:elevation="6dp"
            app:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnSave"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Nút lưu ảnh (ở giữa) -->
        <ImageButton
            android:id="@+id/btnSave"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/btn_round_dark"
            android:padding="10dp"
            android:src="@drawable/ic_check"
            android:contentDescription="Lưu ảnh"
            android:visibility="gone"
            app:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Nút quay lại (góc dưới phải) -->
        <ImageButton
            android:id="@+id/btnBackToCamera"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/btn_round_dark"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Quay lại"
            android:visibility="gone"
            android:elevation="6dp"
            app:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toEndOf="@+id/btnSave" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
