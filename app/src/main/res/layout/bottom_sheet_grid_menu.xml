<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_bg"
    android:padding="20dp">

    <!-- Tiêu đề -->
    <TextView
        android:id="@+id/tvMenuTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tùy chọn"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Nút đóng -->
    <ImageButton
        android:id="@+id/btnCloseMenu"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_back"
        android:contentDescription="Đóng"
        android:padding="8dp"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Grid Option -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardGrid"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_marginTop="20dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#2A2A2A"
        app:layout_constraintTop_toBottomOf="@+id/tvMenuTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ivGridIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_grid"
                app:tint="#FFFFFF"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvGridTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Grid Lines"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginStart="16dp"
                app:layout_constraintTop_toTopOf="@+id/ivGridIcon"
                app:layout_constraintStart_toEndOf="@+id/ivGridIcon"
                app:layout_constraintEnd_toStartOf="@+id/switchGrid" />

            <TextView
                android:id="@+id/tvGridSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Hiển thị lưới căn chỉnh"
                android:textSize="12sp"
                android:textColor="#AAAAAA"
                app:layout_constraintTop_toBottomOf="@+id/tvGridTitle"
                app:layout_constraintStart_toStartOf="@+id/tvGridTitle"
                app:layout_constraintEnd_toStartOf="@+id/switchGrid" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/switch_thumb"
                app:trackTint="@color/switch_track"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Countdown Option -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardCountdown"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#2A2A2A"
        app:layout_constraintTop_toBottomOf="@+id/cardGrid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ivCountdownIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_timer"
                app:tint="#FFFFFF"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvCountdownTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Countdown Timer"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginStart="16dp"
                app:layout_constraintTop_toTopOf="@+id/ivCountdownIcon"
                app:layout_constraintStart_toEndOf="@+id/ivCountdownIcon"
                app:layout_constraintEnd_toStartOf="@+id/switchCountdown" />

            <TextView
                android:id="@+id/tvCountdownSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Đếm ngược 3 giây trước khi chụp"
                android:textSize="12sp"
                android:textColor="#AAAAAA"
                app:layout_constraintTop_toBottomOf="@+id/tvCountdownTitle"
                app:layout_constraintStart_toStartOf="@+id/tvCountdownTitle"
                app:layout_constraintEnd_toStartOf="@+id/switchCountdown" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/switch_thumb"
                app:trackTint="@color/switch_track"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>

