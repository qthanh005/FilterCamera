<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Trạng thái khi nhấn -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#FF8E8E"
                android:endColor="#FFB380" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    
    <!-- Trạng thái khi được kích hoạt -->
    <item android:state_enabled="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#FF6B6B"
                android:endColor="#FF8E53" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    
    <!-- Trạng thái mặc định -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#CC6B6B"
                android:endColor="#CC8E53" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</selector>

